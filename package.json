{
  "name": "wovenwhale-commerce",
  "private": true,
  "version": "0.1.0",
  "description": "WovenWhale D2C commerce platform — storefront, admin and commerce API.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:reset": "npm run db:reset -w backend",
    "catalog:import": "npm run catalog:import -w backend --",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "test": "npm run test -w backend",
    "test:e2e": "npm run test:e2e -w frontend",
    "format": "prettier --write \"backend/**/*.ts\" \"frontend/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"backend/**/*.ts\" \"frontend/**/*.{ts,tsx,css}\"",
    "db:verify": "npm run db:verify -w backend"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
