# ─────────────────────────────────────────────────────────────────────────────
# DEMO deployment — copy to .env.demo (git-ignored) and fill in the blanks.
# Used to migrate and seed the demo database from your machine, and as the
# source of the values you paste into Render (API) and Vercel (storefront).
# DEMO ONLY: payments are simulated, OTP is a fixed code, credentials are public.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
DEMO_MODE=true

# Your Vercel storefront URL (https) — also the only allowed origin.
SITE_URL=https://wovenwhale-demo.vercel.app
ALLOWED_ORIGINS=https://wovenwhale-demo.vercel.app

# Supabase demo project → Connect → Session pooler (port 5432), with ?sslmode=require
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_MAX=5

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
MFA_ENCRYPTION_KEY=
MOCK_PAYMENT_WEBHOOK_SECRET=

# Admin 2FA is on. Demo admins are pre-enrolled with this key (base32). Generate with:
# node -e "const a='ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';console.log(Array.from(require('crypto').randomBytes(32),b=>a[b%32]).join(''))"
ADMIN_MFA_REQUIRED=true
DEMO_TOTP_SECRET=

TRUSTED_PROXY_HOPS=4

PAYMENT_PROVIDER=mock
# To use Razorpay test mode instead, set PAYMENT_PROVIDER=razorpay and rzp_test_ keys:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

OTP_PROVIDER=mock
OTP_DEV_FIXED_CODE=123456
WHATSAPP_PROVIDER=log
WHATSAPP_SEND_ENABLED=false
STORAGE_PROVIDER=local

# Seed-only (DEMO ONLY)
SEED_SUPER_ADMIN_EMAIL=owner@wovenwhale.local
SEED_SUPER_ADMIN_PASSWORD=Demo-Only-2026!
DEMO_ADMIN_PASSWORD=Demo-Only-2026!
