{
  "name": "@wovenwhale/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./contracts": "./src/contracts/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --sourcemap --outfile=dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../.env seed/index.ts",
    "db:reset": "tsx --env-file-if-exists=../.env seed/reset.ts && npm run db:migrate && npm run db:seed",
    "catalog:import": "tsx --env-file-if-exists=../.env scripts/import-catalog.ts",
    "jobs:run": "tsx --env-file-if-exists=../.env src/jobs/run-once.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:bootstrap": "tsx --env-file-if-exists=../.env scripts/bootstrap.ts",
    "db:verify": "tsx --env-file-if-exists=../.env scripts/verify-db.ts",
    "demo:migrate": "tsx --env-file=../.env.demo src/db/migrate.ts",
    "demo:verify": "tsx --env-file=../.env.demo scripts/verify-db.ts",
    "demo:seed": "tsx --env-file=../.env.demo seed/index.ts",
    "demo:reset": "tsx --env-file=../.env.demo seed/demo-reset.ts",
    "catalog:images": "tsx scripts/catalog/images-to-webp.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  }
}
