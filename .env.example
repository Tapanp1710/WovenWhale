# ─────────────────────────────────────────────────────────────────────────────
# WovenWhale Commerce — environment template
# Copy to `.env` at the repository root. Never commit real secrets.
# Both backend/ and frontend/ load this root file.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Public demo deployments only (docs/demo.md): allows the simulated gateway and a
# fixed OTP under NODE_ENV=production and labels every page. Never on the real store.
DEMO_MODE=false
# DEMO_MODE seeding: base32 authenticator key pre-enrolled for the demo admins, and their password.
DEMO_TOTP_SECRET=
DEMO_ADMIN_PASSWORD=Demo-Only-2026!

# ── Core URLs ────────────────────────────────────────────────────────────────
# Public storefront origin (used for canonical URLs, sitemap, CSRF origin checks)
SITE_URL=http://localhost:3000
# Commerce API origin (server-to-server; the browser reaches it through /api rewrites)
BACKEND_URL=http://localhost:4000
BACKEND_PORT=4000
# Comma-separated list of origins allowed to send state-changing requests.
# Also the hosts the Next dev server accepts: add e.g. http://192.168.1.5:3000 to open the site from another device or a WSL IP.
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# DEVELOPMENT (local):  docker compose Postgres (below).
# DEVELOPMENT (cloud) / STAGING / PRODUCTION: that environment's own Supabase project,
#   "Transaction pooler" string, port 6543, with ?sslmode=require. Never point
#   development or staging at the production database.
DATABASE_URL=postgres://wovenwhale:wovenwhale@localhost:54329/wovenwhale
DATABASE_POOL_MAX=10

# ── Supabase (optional — storage provider / future auth provider) ────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Sessions & security ──────────────────────────────────────────────────────
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
CUSTOMER_SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12
# Admin two-factor authentication (TOTP). Must be true in production.
ADMIN_MFA_REQUIRED=false
# Encrypts TOTP secrets and keys recovery-code hashes. Required (32+ chars, not
# the SESSION_SECRET) in production. NEVER rotate in place: existing 2FA enrolments
# depend on it. Generate like SESSION_SECRET.
MFA_ENCRYPTION_KEY=

# Client IP for rate limiting. Required in production: set ONE of these to match
# the proxies in front of the API (see docs/deployment.md). Forwarding headers
# are otherwise ignored because clients can forge them.
#   CLIENT_IP_HEADER: header your edge overwrites with the client IP, e.g. cf-connecting-ip
#   TRUSTED_PROXY_HOPS: number of proxies you run that append to X-Forwarded-For
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=0

# ── Hidden admin portal shortcut (convenience only — NOT authentication) ─────
ADMIN_PORTAL_TRIGGER=7391

# ── Business rules ───────────────────────────────────────────────────────────
ORDER_CANCELLATION_WINDOW_HOURS=12
RETURN_WINDOW_DAYS=14
PAYMENT_TIMEOUT_MINUTES=30
ABANDONED_CHECKOUT_THRESHOLD_MINUTES=60

# ── Providers (mock implementations are used when a provider is `mock`) ──────
# Mock providers are refused when NODE_ENV=production.
PAYMENT_PROVIDER=mock
OTP_PROVIDER=mock
WHATSAPP_PROVIDER=log
SHIPPING_PROVIDER=manual
EMAIL_PROVIDER=console
STORAGE_PROVIDER=local
# Where STORAGE_PROVIDER=local writes uploads (relative to the API's working directory)
UPLOAD_DIR=uploads

# Development-only fixed OTP (ignored in production). Leave empty to log random codes.
OTP_DEV_FIXED_CODE=123456
# Secret used by the mock payment gateway to sign simulated webhooks
MOCK_PAYMENT_WEBHOOK_SECRET=dev-mock-gateway-secret

# ── Razorpay (PAYMENT_PROVIDER=razorpay) ─────────────────────────────────────
# Dashboard → Account & Settings → API Keys. Use rzp_test_ keys in development
# and staging, rzp_live_ keys only in production. KEY_ID is publishable; the
# secrets are server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → the secret you set on /api/webhooks/payments/razorpay
RAZORPAY_WEBHOOK_SECRET=

# ── Twilio Verify (OTP_PROVIDER=twilio) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# sms or whatsapp
TWILIO_VERIFY_CHANNEL=sms
# Reserved for an MSG91 adapter (not implemented yet)
OTP_API_KEY=

# ── WhatsApp Cloud API (WHATSAPP_PROVIDER=meta) ──────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
# Outbound messages stay disabled until this is true, WHATSAPP_PROVIDER=meta and
# each template is approved by Meta and marked approved/active in Admin → WhatsApp.
WHATSAPP_SEND_ENABLED=false

# ── Shipping (manual provider today; aggregator adapters later) ──────────────
# SHIPPING_WEBHOOK_SECRET signs tracking updates sent to /api/webhooks/shipping/manual
SHIPPING_API_KEY=
SHIPPING_WEBHOOK_SECRET=

# ── Email (console provider today; Resend / SES adapters later) ──────────────
EMAIL_API_KEY=
EMAIL_FROM=WovenWhale <orders@wovenwhale.com>

# ── Queue / cache ────────────────────────────────────────────────────────────
REDIS_URL=

# ── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── DEVELOPMENT seed only: initial super-admin. Not a production credential. ─
# Production uses `npm run db:bootstrap -w backend` with its own strong password.
SEED_SUPER_ADMIN_EMAIL=owner@wovenwhale.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!2026

# ── Storefront contact details (shown on /contact and /support when set) ─────
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_HOURS=Monday to Saturday, 10am to 6pm IST

# ── Local tooling ────────────────────────────────────────────────────────────
# Set to false to disable Turbopack's on-disk dev cache on low-disk machines
NEXT_DEV_FS_CACHE=true

# Local/CI only: scale rate limits for automated test runs (must be 1 in production)
RATE_LIMIT_MULTIPLIER=1
