# ─────────────────────────────────────────────────────────────────────────────
# WovenWhale Commerce — environment template
# Copy to `.env` at the repository root. Never commit real secrets.
# Both backend/ and frontend/ load this root file.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Core URLs ────────────────────────────────────────────────────────────────
# Public storefront origin (used for canonical URLs, sitemap, CSRF origin checks)
SITE_URL=http://localhost:3000
# Commerce API origin (server-to-server; the browser reaches it through /api rewrites)
BACKEND_URL=http://localhost:4000
BACKEND_PORT=4000
# Comma-separated list of origins allowed to send state-changing requests
ALLOWED_ORIGINS=http://localhost:3000

# ── Database (Supabase Postgres in production) ───────────────────────────────
# Local: docker compose Postgres. Production: Supabase pooled connection string.
DATABASE_URL=postgres://wovenwhale:wovenwhale@localhost:54329/wovenwhale
DATABASE_POOL_MAX=10

# ── Supabase (optional — storage provider / future auth provider) ────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Sessions & security ──────────────────────────────────────────────────────
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
CUSTOMER_SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12

# ── Hidden admin portal shortcut (convenience only — NOT authentication) ─────
ADMIN_PORTAL_TRIGGER=7391

# ── Business rules ───────────────────────────────────────────────────────────
ORDER_CANCELLATION_WINDOW_HOURS=12
RETURN_WINDOW_DAYS=14
PAYMENT_TIMEOUT_MINUTES=30
ABANDONED_CHECKOUT_THRESHOLD_MINUTES=60

# ── Providers (mock implementations are used when a provider is `mock`) ──────
# Mock providers are refused when NODE_ENV=production.
PAYMENT_PROVIDER=mock
OTP_PROVIDER=mock
WHATSAPP_PROVIDER=log
SHIPPING_PROVIDER=manual
EMAIL_PROVIDER=console
STORAGE_PROVIDER=local

# Development-only fixed OTP (ignored in production). Leave empty to log random codes.
OTP_DEV_FIXED_CODE=123456
# Secret used by the mock payment gateway to sign simulated webhooks
MOCK_PAYMENT_WEBHOOK_SECRET=dev-mock-gateway-secret

# ── Razorpay (future) ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── OTP provider (future: MSG91 / Twilio Verify / Supabase phone auth) ───────
OTP_API_KEY=

# ── WhatsApp Cloud API (future) ──────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Outbound messages stay disabled until business rules are approved
WHATSAPP_SEND_ENABLED=false

# ── Shipping aggregator (future: Shiprocket / Delhivery) ─────────────────────
SHIPPING_API_KEY=
SHIPPING_WEBHOOK_SECRET=

# ── Email (future: Resend / SES) ─────────────────────────────────────────────
EMAIL_API_KEY=
EMAIL_FROM=WovenWhale <orders@wovenwhale.com>

# ── Queue / cache ────────────────────────────────────────────────────────────
REDIS_URL=

# ── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Development seed: initial super-admin (seed only; change immediately) ────
SEED_SUPER_ADMIN_EMAIL=owner@wovenwhale.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!2026

# ── Storefront contact details (shown on /contact and /support when set) ─────
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_HOURS=Monday to Saturday, 10am to 6pm IST

# ── Local tooling ────────────────────────────────────────────────────────────
# Set to false to disable Turbopack's on-disk dev cache on low-disk machines
NEXT_DEV_FS_CACHE=true

# Local/CI only: scale rate limits for automated test runs (must be 1 in production)
RATE_LIMIT_MULTIPLIER=1
